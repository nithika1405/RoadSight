# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and adjust before running `npm run dev`.
# ---------------------------------------------------------------------------

# Leave empty to talk to the backend through the Vite dev-server proxy
# (recommended). Set an absolute URL when the API lives on another host.
VITE_API_BASE_URL=

# Google Maps JavaScript API key (Maps JavaScript API enabled).
# When this is empty the map falls back to the key-free Google tile layer.
VITE_GOOGLE_MAPS_API_KEY=

# Target used by the Vite dev proxy for /api, /media and /thumbnails.
VITE_PROXY_TARGET=http://127.0.0.1:8000
